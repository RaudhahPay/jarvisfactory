# JarvisFactory v12 Template — environment variables
# Copy to `.env.local` for local dev.
# For production: set vars in wrangler.jsonc (public) + Cloudflare Secrets (private).
# Per SOP §4.5.

# PUBLIC (safe to commit / expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx.your-public-anon-key.xxx

# PRIVATE (server-only — never commit, never expose client-side)
# This is the service-role key for the admin client per SOP §4.2.
# Cloudflare Workers: `wrangler secret put SUPABASE_SERVICE_ROLE_KEY`
SUPABASE_SERVICE_ROLE_KEY=eyJxxx.your-service-role-key-NEVER-commit.xxx

# App URL (used by some flows e.g. auth callbacks)
# Default 3100 because JarvisFactory itself runs on :3000 during local dev.
# Override to 3000 (or any free port) if you're running this standalone.
NEXT_PUBLIC_APP_URL=http://localhost:3100
