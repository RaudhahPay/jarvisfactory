{
  "name": "jarvisfactory-v12-template",
  "version": "1.0.0",
  "private": true,
  "description": "Canonical Next.js 15 + Tailwind + shadcn + Supabase + Cloudflare template. Cloned by JarvisFactory for every v12 app build. Aligned to Software Development SOP §4.1.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preship": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
