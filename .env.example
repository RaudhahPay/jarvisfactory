# JarvisFactory — environment variable template
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-publishable-key

# --- Anthropic (Claude API) ---
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# --- GitHub OAuth ---
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret
NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id

# --- v2 engine (Stage 4) ---
# Set to 1 to route builds through the server-side Agent SDK (/api/build) instead of
# the v1 in-browser pipeline. Requires Anthropic prepaid credits for the real runner.
NEXT_PUBLIC_V2_ENGINE=0

# --- v2 sandbox (Stage 4 / S4) ---
# Leave unset to use the in-memory stub driver. Set to 'cloudflare' + deploy
# sandbox-worker/ (see its README) to use real Cloudflare Sandbox containers.
SANDBOX_PROVIDER=stub
SANDBOX_BRIDGE_URL=
SANDBOX_BRIDGE_TOKEN=

# Per-user monthly spend cap (USD) when profiles.monthly_cost_limit_usd is unset. 0=unlimited.
DEFAULT_MONTHLY_COST_LIMIT_USD=5
