{
  "name": "jarvisfactory",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:server & npm run dev:web",
    "dev:web": "cd web && npx vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "cd web && npx vite build",
    "build:server": "npx esbuild server/index.ts --bundle --platform=node --format=esm --outdir=server/dist --packages=external",
    "start": "node server/dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.173",
    "@cloudflare/containers": "^0.3.7",
    "@hono/node-server": "^2.0.4",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "hono": "^4.12.25",
    "next": "^14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "react-router-dom": "^6.26.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
