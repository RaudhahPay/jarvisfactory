# JarvisFactory — Dev Container
# This sets up a Node.js environment identical for everyone on the team.
# Use with docker-compose for hot-reload local dev.

FROM node:22-alpine

# Install basic tools (curl for health checks, git for any git operations)
RUN apk add --no-cache curl git

# Set working directory inside the container
WORKDIR /app

# Copy package files first (Docker caches this layer — only re-installs if package.json changes)
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm install

# Copy the rest of the source code
# (In dev mode this gets overridden by the volume mount in docker-compose)
COPY . .

# Expose Next.js dev server port
EXPOSE 3000

# Health check — Docker can detect if the app is alive
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:3000 || exit 1

# Default command — start dev server with hot reload
# Hostname 0.0.0.0 is required to accept connections from outside the container
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0"]
